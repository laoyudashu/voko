# Optional VOKO cloud API endpoint override.
VOKO_API_URL=https://www.vokovoko.com

# Optional Aliyun OSS credentials for the private release workflow.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Optional runtime overrides.
VOKO_PORT=3100
VOKO_LOCALE=en
VOKO_DB_PATH=
VOKO_AUTO_UPDATE_INTERVAL_MS=

# Optional ZeroClaw ACP-over-WebSocket connection.
# Keep the gateway on loopback; obtain the token through ZeroClaw pairing.
ZEROCLAW_ACP_URL=ws://127.0.0.1:42617/acp
ZEROCLAW_ACP_TOKEN=
