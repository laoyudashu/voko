# Copy to .env.real-test.local. Never use a personal or production Agent.
VOKO_REAL_DB_PATH=C:\absolute\path\to\test-voko.db
VOKO_REAL_AGENT_ID=test-agent
VOKO_REAL_PEER_UID=test-visitor
# Optional real group and attachment checks:
VOKO_REAL_GROUP_ID=test-group
VOKO_REAL_TEST_FILE=C:\absolute\path\to\small-test-file.txt
# Stability sends one uniquely tagged message at this interval.
VOKO_REAL_INTERVAL=30s

# Internal E2EE-TOFU Canary. Each OS uses a distinct allowlisted device identity.
# Use a dedicated test Agent and stop its normal VOKO worker before running; the
# runner temporarily owns its IM session.
VOKO_E2EE_CANARY_WINDOWS_OWNER_DEVICE_KEY_ID=windows-canary-owner-device
VOKO_E2EE_CANARY_WINDOWS_BROWSER_DEVICE_KEY_ID=windows-canary-browser-device
VOKO_E2EE_CANARY_LINUX_OWNER_DEVICE_KEY_ID=ubuntu-canary-owner-device
VOKO_E2EE_CANARY_LINUX_BROWSER_DEVICE_KEY_ID=ubuntu-canary-browser-device
VOKO_E2EE_CANARY_ALLOW_AGENT_SESSION=true
