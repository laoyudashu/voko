# Copy to .env.real-matrix.local. Do not store credentials or Provider session IDs.
VOKO_REAL_MAC_VOKO=/absolute/path/to/voko
VOKO_REAL_WINDOWS_VM=Windows 11
VOKO_REAL_WINDOWS_NODE=C:\\Path\\to\\node.exe
VOKO_REAL_WINDOWS_ENTRY=C:\\Path\\to\\node_modules\\@voko\\lite\\build\\index.js
VOKO_REAL_LINUX_VM=UTM-UUID
VOKO_REAL_LINUX_NODE=/absolute/path/to/node
VOKO_REAL_LINUX_ENTRY=/absolute/path/to/@voko/lite/build/index.js
VOKO_REAL_LINUX_USER=user
VOKO_REAL_LINUX_UID=1000
VOKO_REAL_MATRIX_SENDERS={"macos":{"agentName":"AUTO-REG-MAC","backendType":"others","restoreVisibility":0},"windows":{"agentName":"AUTO-REG-WINDOWS","backendType":"others","restoreVisibility":0},"linux":{"agentName":"AUTO-REG-LINUX","backendType":"others","restoreVisibility":0}}
VOKO_REAL_MATRIX_TARGETS=[{"senderHost":"macos","host":"windows","agentName":"TEST-WINDOWS-PROVIDER","backendType":"provider","restoreVisibility":0}]
